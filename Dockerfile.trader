FROM python:3.12-slim

WORKDIR /app

# 安装系统依赖和 Node.js
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# 安装 gemini-cli 和 qwen-code CLI
RUN npm install -g @google/gemini-cli @qwen-code/qwen-code@latest

# 安装 uv
RUN pip install uv

# 复制依赖文件
COPY pyproject.toml uv.lock* ./

# 安装依赖
RUN uv pip install --system -e .

# 复制源代码
COPY src/ ./src/

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

# 启动脚本：清理 CLI 工具的 MCP 配置（宿主机挂载的配置含 MCP servers，容器内会卡死）
COPY docker-entrypoint-trader.sh /app/docker-entrypoint-trader.sh
RUN chmod +x /app/docker-entrypoint-trader.sh

CMD ["/app/docker-entrypoint-trader.sh"]
