# ============= 交易所配置 =============
WEEX_API_KEY=your_api_key
WEEX_API_SECRET=your_api_secret
WEEX_PASSPHRASE=your_passphrase
WEEX_API_URL=https://api-contract.weex.com

# ============= 代理配置 (可选) =============
PROXY_URL=http://user:pwd@1.1.1.1:8080

# ============= 交易对配置 =============
TRADING_SYMBOL=cmt_btcusdt

# ============= AI模型配置 (新版 - 推荐使用) =============
# Provider 类型: openrouter | deepseek | glm | gemini
LLM_PROVIDER=openrouter
LLM_API_KEY=your_provider_api_key
LLM_MODEL=deepseek/deepseek-chat
LLM_FALLBACK_MODEL=minimax/minimax-01
# LLM_BASE_URL=  # 可选：自定义 API 端点
# LLM_TIMEOUT=60  # 可选：超时时间(秒)

# ============= AI模型配置 (旧版 - 兼容) =============
# OPENROUTER_API_KEY=your_openrouter_key  # 已废弃，请使用 LLM_API_KEY
# AI_MODEL=deepseek/deepseek-chat        # 已废弃，请使用 LLM_MODEL
# AI_FALLBACK_MODEL=minimax/minimax-01   # 已废弃，请使用 LLM_FALLBACK_MODEL

# ============= 杠杆配置 =============
LEVERAGE_MIN=3
LEVERAGE_MAX=10
DEFAULT_LEVERAGE=5

# ============= 风险控制 =============
STOP_LOSS_PERCENT=5.0
TAKE_PROFIT_PERCENT=10.0
MAX_POSITION_PERCENT=20.0

# ============= 交易策略 =============
# short_term | long_term | balanced
TRADING_STRATEGY=balanced
ANALYSIS_INTERVAL=15
DECISION_INTERVAL=60

# ============= 日志配置 =============
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log
