# ============= 交易所配置 =============
WEEX_API_KEY=your_api_key
WEEX_API_SECRET=your_api_secret
WEEX_PASSPHRASE=your_passphrase
WEEX_API_URL=https://api-contract.weex.com

# ============= 代理配置 (可选) =============
PROXY_URL=http://user:pwd@1.1.1.1:8080

# ============= 交易对配置 =============
TRADING_SYMBOL=cmt_btcusdt

# ============= AI模型配置 (新版 - 推荐使用) =============
# Provider 类型: openrouter | deepseek | glm | gemini
LLM_PROVIDER=openrouter
LLM_API_KEY=your_provider_api_key
LLM_MODEL=deepseek/deepseek-v3.2
LLM_FALLBACK_MODEL=deepseek/deepseek-chat
# LLM_BASE_URL=  # 可选：自定义 API 端点
# LLM_TIMEOUT=60  # 可选：超时时间(秒)

# ============= AI模型配置 (旧版 - 兼容) =============
# OPENROUTER_API_KEY=your_openrouter_key  # 已废弃，请使用 LLM_API_KEY
# AI_MODEL=deepseek/deepseek-chat        # 已废弃，请使用 LLM_MODEL
# AI_FALLBACK_MODEL=minimax/minimax-01   # 已废弃，请使用 LLM_FALLBACK_MODEL

# ============= 杠杆配置 =============
LEVERAGE_MIN=3
LEVERAGE_MAX=10
DEFAULT_LEVERAGE=5

# ============= 风险控制 =============
STOP_LOSS_PERCENT=5.0
TAKE_PROFIT_PERCENT=10.0
MAX_POSITION_PERCENT=20.0

# ============= 交易策略 =============
# short_term | long_term | balanced
TRADING_STRATEGY=balanced
ANALYSIS_INTERVAL=15
DECISION_INTERVAL=60

# ============= Dashboard 配置 =============
# Session 密钥（至少32字符）
SESSION_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
# Dashboard 登录密码
DASHBOARD_PASSWORD=your-secure-password
# Trader WebSocket URL（Docker 内部通信用 ws://trader:8000/ws）
TRADER_WS_URL=ws://localhost:8000/ws

# ============= Dashboard 数据库配置 =============
# PostgreSQL 连接 URL，用于将决策数据持久化到 Dashboard
DASHBOARD_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trader_dashboard
# 是否启用决策持久化（默认关闭）
ENABLE_DECISION_PERSISTENCE=false

# ============= 日志配置 =============
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log

# ============= Redis 配置 =============
REDIS_URL=redis://:password@localhost:6379
