# ============= 情绪分析配置 =============

# 启用情绪分析（可选功能）
ENABLE_SENTIMENT_ANALYSIS=true

# NewsAPI（✅ 已验证可用）
# 注册地址：https://newsapi.org/
# 免费额度：100次/天
NEWSAPI_KEY=your_newsapi_key_here

# CryptoPanic（⚠️ 暂不可用 - API端点问题）
# 注册地址：https://cryptopanic.com/developers/api/
# 状态：2026-01-27 测试时所有端点返回404
# 建议：暂时注释掉，仅使用 NewsAPI
# CRYPTOPANIC_API_KEY=your_cryptopanic_key_here

# 权重配置
SENTIMENT_WEIGHT=0.2              # 情绪分析权重（0-1）
QUANT_WEIGHT=0.5                  # 量化策略权重
AI_WEIGHT=0.5                     # AI分析权重

# 缓存配置
SENTIMENT_CACHE_TTL=900           # 缓存TTL（秒，15分钟）
SENTIMENT_MAX_REQUESTS_PER_HOUR=80  # 每小时最大请求数（留20%余量）

# 说明：
# 1. NewsAPI 完全正常，可获取加密货币相关新闻
# 2. 仅使用 NewsAPI 也能进行完整的情绪分析
# 3. CryptoPanic 问题不影响功能使用
